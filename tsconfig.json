{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": ["chrome", "node", "vitest/globals"],
    "outDir": "dist"
  },
  "include": ["src", "tests", "vitest.config.ts"]
}
