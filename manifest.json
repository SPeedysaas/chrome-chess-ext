{
  "manifest_version": 3,
  "name": "Chess.com Board Detector",
  "version": "0.5.1",
  "permissions": ["storage"],
  "host_permissions": ["https://www.chess.com/*", "https://lichess.org/*"],
  "web_accessible_resources": [
    {
      "resources": ["lichess-svgrepo-com.svg"],
      "matches": ["https://www.chess.com/*"]
    }
  ],
  "action": {
    "default_title": "Chess.com Board Detector",
    "default_popup": "popup/index.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*"],
      "js": ["dist/content/index.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://lichess.org/paste*"],
      "js": ["dist/content/lichessPasteImport.js"],
      "run_at": "document_idle"
    }
  ]
}
